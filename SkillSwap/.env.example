# Platform
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# Modo gratuito: não cobra usuários nem disponibiliza checkout.
APP_COMMERCE_ENABLED=false
# E-mail Firebase que recebera ADMIN no primeiro login (nao e senha; nao grave credenciais aqui).
INITIAL_ADMIN_EMAIL=admin@example.com
PRIVACY_CONTROLLER_NAME=Nome da pessoa ou entidade controladora
PRIVACY_CONTROLLER_CONTACT=privacidade@example.com
PRIVACY_DPO_NAME=Nome do encarregado ou DPO
PRIVACY_DPO_CONTACT=dpo@example.com
PRIVACY_JURISDICTION=Brasil

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/skillswap
DB_USERNAME=skillswap
DB_PASSWORD=change-this-in-a-secret-manager

# Stripe: server-side only. Use separate test and live keys.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional integrations (leave empty when not enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
# Produção: true com broker disponível; false mantém fallback síncrono idempotente.
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=skillswap.payments
RABBITMQ_QUEUE=skillswap.payments.fulfillment
RABBITMQ_ROUTING_KEY=payment.fulfillment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=hybrid
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_JSON=
