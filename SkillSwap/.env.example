# Platform
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# E-mail Firebase que recebera ADMIN no primeiro login (nao e senha; nao grave credenciais aqui).
INITIAL_ADMIN_EMAIL=admin@example.com

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/skillswap
DB_USERNAME=skillswap
DB_PASSWORD=change-this-in-a-secret-manager

# Stripe: server-side only. Use separate test and live keys.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional integrations (leave empty when not enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
# Produção: true com broker disponível; false mantém fallback síncrono idempotente.
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=skillswap.payments
RABBITMQ_QUEUE=skillswap.payments.fulfillment
RABBITMQ_ROUTING_KEY=payment.fulfillment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=10
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
SUPPORT_EMAIL=suporte.skillswap@gmail.com

# Notificações: ficam no painel, são enviadas por e-mail e podem usar push web.
# Nunca coloque chaves reais neste arquivo ou no Git.
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_PUSH_ENABLED=true
NOTIFICATIONS_TIME_ZONE=America/Sao_Paulo
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=notificacoes@example.com
BREVO_SENDER_NAME=SkillSwap
